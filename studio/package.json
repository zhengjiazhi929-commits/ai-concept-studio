{
  "name": "ai-concept-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "start": "node src/server/app.mjs",
    "start:open": "node scripts/start-studio.mjs",
    "dev": "node --watch src/server/app.mjs",
    "import:golden": "node scripts/import-golden-sample.mjs",
    "import:trends": "node scripts/import-trend-snapshot.mjs",
    "trends": "node scripts/run-trend-radar.mjs",
    "collect": "node scripts/run-collector.mjs",
    "import:collector": "node scripts/import-collector-batch.mjs",
    "research": "node scripts/run-research.mjs",
    "import:research": "node scripts/import-research-evidence.mjs",
    "cloud:status": "node scripts/cloud-status.mjs",
    "cloud:backup": "node scripts/run-cloud-backup.mjs",
    "render:preview": "node scripts/render-preview.mjs golden-001",
    "render:agent-skill-visual-proof": "node scripts/render-agent-skill-visual-proof.mjs",
    "build:agent-skill-natural-voice-proof": "node scripts/build-agent-skill-natural-voice-proof.mjs",
    "build:agent-skill-local-tts-proof": "node scripts/build-agent-skill-local-tts-proof.mjs",
    "build:agent-skill-short-local-tts-candidate": "node scripts/build-agent-skill-short-local-tts-candidate.mjs",
    "build:golden-local-voice": "node scripts/build-golden-local-voice-candidate.mjs",
    "prepare:golden-upstream-gate": "node scripts/prepare-golden-m1-upstream-gate.mjs",
    "build:golden-gate-dossier": "node scripts/build-golden-assets-voice-gate-dossier.mjs",
    "render:visual-sample": "node scripts/render-visual-system-sample.mjs",
    "qa:visual-transition": "node scripts/render-transition-qa.mjs",
    "qa": "node scripts/qa-preview.mjs golden-001",
    "motion:archive": "node scripts/archive-motion-library-upstream.mjs",
    "motion:docs": "node scripts/generate-motion-library-docs.mjs",
    "motion:previews": "node scripts/render-motion-library-previews.mjs",
    "motion:check": "node scripts/check-motion-library.mjs",
    "motion:gallery": "pnpm --package=@remotion/cli@4.0.504 dlx remotion studio src/video/motion-library/index.jsx --no-open --port=4318",
    "ci:render-smoke": "node scripts/ci-render-smoke.mjs",
    "scan:secrets": "node scripts/scan-tracked-secrets.mjs",
    "eval:attested": "node scripts/run-attested-evaluation.mjs",
    "rehearse:rollback": "node scripts/rehearse-remediation-rollback.mjs",
    "test": "node --test tests/*.test.mjs",
    "precheck": "node --check src/shared/redaction.mjs && node --check src/video/agent-skill-motion-plan.mjs && node --check src/video/agent-skill-full-video-plan.mjs && node --check src/server/reviews/human-approval-view.mjs && node --check src/server/reviews/asset-execution-preflight-runner.mjs && node --check src/server/production/external-assets.mjs && node --check src/server/security/operator-session.mjs && node --check scripts/render-agent-skill-full-video-stills.mjs && node --check scripts/start-studio.mjs",
    "check": "node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/bundler": "4.0.504",
    "@remotion/renderer": "4.0.504",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.504",
    "undici": "7.29.0"
  }
}
