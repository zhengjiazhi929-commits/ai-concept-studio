# Copy this file to .env.local. Never commit real keys.
AIHUBMIX_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=

# Local operator control plane. Keep real values only in ignored .env.local.
# All three values are required together. Without them, every mutating HTTP API
# fails closed while read-only pages remain available.
AI_CONCEPT_STUDIO_OPERATOR_ACTOR=
AI_CONCEPT_STUDIO_OPERATOR_TOKEN=
AI_CONCEPT_STUDIO_CAPABILITY_SECRET=

# Server policy caps for a single issued side-effect capability. Paid/model
# operations remain disabled when calls or cost are left at zero.
AI_CONCEPT_STUDIO_CAPABILITY_MAX_CALLS=0
AI_CONCEPT_STUDIO_CAPABILITY_MAX_COST_USD=0
# AI_CONCEPT_STUDIO_CAPABILITY_TTL_MS=30000
# AI_CONCEPT_STUDIO_CAPABILITY_MAXIMUM_TTL_MS=300000

# Optional second factor for the especially sensitive ambiguous-budget endpoint.
AI_CONCEPT_STUDIO_BUDGET_RECONCILIATION_TOKEN=

# Optional: override the primary channel or provider-specific model ID.
# AI_PRIMARY_PROVIDER=aihubmix
# AIHUBMIX_MODEL=gpt-5.4-mini
# OPENAI_MODEL=gpt-5.4-mini

# Optional on Windows/Linux when the runtime cannot read a system proxy.
# HTTPS_PROXY=http://127.0.0.1:7897
