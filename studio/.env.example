# Copy this file to .env.local. Never commit real keys.
AIHUBMIX_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=

# Optional: override the primary channel or provider-specific model ID.
# AI_PRIMARY_PROVIDER=aihubmix
# AIHUBMIX_MODEL=gpt-5.4-mini
# OPENAI_MODEL=gpt-5.4-mini

# Optional on Windows/Linux when the runtime cannot read a system proxy.
# HTTPS_PROXY=http://127.0.0.1:7897
